# Supabase Database Configuration
# Get these values from your Supabase project dashboard:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Click "Settings" > "Database"
# 4. Copy the connection parameters below

# PostgreSQL Host (from Connection Details)
SUPABASE_HOST=aws-1-ap-south-1.pooler.supabase.com

# PostgreSQL Port (usually 5432)
SUPABASE_PORT=5432

# PostgreSQL User (format: postgres.xxxxx where x is your project reference)
SUPABASE_USER=postgres.ixmvlhdqrcokeqhrdifr

# PostgreSQL Password (from Connection Details - Keep this SECRET!)
# Never commit this file with the actual password to Git
SUPABASE_PASSWORD=your_actual_password_here

# JWT Secret (used for authentication tokens)
JWT_SECRET=your_jwt_secret_key_change_in_production
